@import "@CACHE@/colors.rasi"
* {
    font: "DejaVu Sans 11";
    background-color: transparent;
    text-color: @on-surface;
    border-color: @outline-variant;
}
window {
    width: 860px;
    background-color: @surface;
    border: 1px;
    border-radius: 20px;
    padding: 20px;
}
mainbox { spacing: 18px; }
inputbar {
    children: [prompt, entry];
    padding: 14px 16px;
    spacing: 12px;
    background-color: @surface-container;
    border-radius: 12px;
}
prompt { text-color: @primary; }
entry { placeholder: "Выбери настроение рабочего стола"; }
listview {
    columns: 3;
    lines: 2;
    fixed-columns: true;
    fixed-height: false;
    flow: horizontal;
    spacing: 12px;
    scrollbar: false;
}
element {
    orientation: vertical;
    height: 264px;
    padding: 6px;
    border: 2px;
    border-color: transparent;
    border-radius: 18px;
    children: [element-icon];
}
element selected.normal {
    border-color: @primary;
    background-color: @surface-container;
}
element-icon { size: 248px; width: 248px; height: 248px; squared: false; horizontal-align: 0.5; }
@media (max-height: 800) {
    window { width: 764px; }
    element { height: 232px; }
    element-icon { size: 216px; width: 216px; height: 216px; }
}
