@import "@CACHE@/colors.rasi"
* {
    font: "DejaVu Sans 11";
    background-color: transparent;
    text-color: @on-surface;
    border-color: @outline-variant;
}
window {
    width: 560px;
    background-color: @surface;
    border: 1px;
    border-radius: 20px;
    padding: 20px;
}
mainbox { spacing: 14px; }
inputbar {
    children: [prompt, entry];
    spacing: 12px;
    padding: 14px 16px;
    background-color: @surface-container;
    border-radius: 12px;
}
prompt { text-color: @primary; }
entry { placeholder: "Поиск…"; }
listview { lines: 7; fixed-height: false; spacing: 6px; scrollbar: false; }
element {
    padding: 12px 14px;
    border: 1px;
    border-color: transparent;
    border-radius: 12px;
    spacing: 12px;
}
element selected.normal {
    background-color: @surface-container-high;
    border-color: @primary;
    text-color: @on-surface;
}
element-text { vertical-align: 0.5; text-color: inherit; }
element-icon { size: 24px; }
