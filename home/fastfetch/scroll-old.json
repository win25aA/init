{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "position": "top",
    "width": 28,
    "padding": {
      "left": 7,
      "right": 0,
      "top": 0,
      "bottom": 1
    }
  },
  "display": {
    "separator": "·  ",
    "key": {
      "type": "string",
      "width": 0
    },
    "color": {
      "keys": "38;2;155;143;119",
      "output": "38;2;221;205;171",
      "separator": "38;2;160;119;74"
    },
    "percent": {
      "type": [
        "num"
      ]
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[1G{#38;2;204;168;105}   ╭───────────────────────────────────╴{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;204;168;105} ╭─╯{#}"
    },
    {
      "type": "title",
      "format": "{#38;2;204;168;105} │              {user-name}@{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;204;168;105} │{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;204;168;105} │   ── Hardware ────────────────{#}"
    },
    {
      "type": "cpu",
      "key": "{#38;2;204;168;105} │{#}    CPU         ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;204;168;105} │{#}   󰾲 GPU         ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#38;2;204;168;105} │{#}    Memory      ",
      "format": "{used} / {total}  ({percentage})"
    },
    {
      "type": "disk",
      "key": "{#38;2;204;168;105} │{#}    Disk        ",
      "folders": "/",
      "format": "{size-used} / {size-total}  ({size-percentage})"
    },
    {
      "type": "swap",
      "key": "{#38;2;204;168;105} │{#}   󰓡 Swap        ",
      "format": "{used} / {total}"
    },
    {
      "type": "battery",
      "key": "{#38;2;204;168;105} │{#}    Battery     ",
      "format": "{capacity} / {status}"
    },
    {
      "type": "custom",
      "format": "{#38;2;204;168;105} │{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;204;168;105} │   ── Software ────────────────{#}"
    },
    {
      "type": "os",
      "key": "{#38;2;204;168;105} │{#}    OS          ",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;204;168;105} │{#}    Kernel      ",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "{#38;2;204;168;105} │{#}    WM          ",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "shell",
      "key": "{#38;2;204;168;105} │{#}    Shell       "
    },
    {
      "type": "terminal",
      "key": "{#38;2;204;168;105} │{#}    Terminal    "
    },
    {
      "type": "packages",
      "key": "{#38;2;204;168;105} │{#}   󰏖 Packages    ",
      "format": "{all}"
    },
    {
      "type": "uptime",
      "key": "{#38;2;204;168;105} │{#}    Uptime      ",
      "format": "{formatted}"
    },
    {
      "type": "custom",
      "format": "{#38;2;204;168;105} │{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;204;168;105} │{#38;2;160;119;74}              ─ · ❦ · ─{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;204;168;105} ╰─╮{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;204;168;105}   ╰───────────────────────────── · ❦{#}"
    }
  ]
}
