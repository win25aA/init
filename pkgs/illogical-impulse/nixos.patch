--- a/dots/.config/quickshell/ii/services/RadioPlayer.qml	1970-01-01 00:00:00.000000000 +0000
+++ c/dots/.config/quickshell/ii/services/RadioPlayer.qml	2026-11-12 16:38:34.715515752 +0000
@@ -0,0 +1,43 @@
+pragma Singleton
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.modules.common
+
+Singleton {
+    id: root
+    property var station: null
+    property bool playing: player.running
+    property var pendingCommand: null
+    readonly property string socketPath: Quickshell.env("XDG_RUNTIME_DIR") ? Quickshell.env("XDG_RUNTIME_DIR") + "/ii-radio-mpv.sock" : ""
+    function setVolume(value) {
+        Config.options.sidebar.radio.volume = Math.max(0, Math.min(100, Math.round(value)))
+        if (player.running && socketPath) volumeTimer.restart()
+    }
+    Timer {
+        id: volumeTimer
+        interval: 70
+        onTriggered: {
+            const payload = JSON.stringify({command: ["set_property", "volume", Config.options.sidebar.radio.volume]})
+            Quickshell.execDetached(["bash", "-c", 'printf "%s\\n" "$1" | socat - "UNIX-CONNECT:$2"', "ii-radio", payload, root.socketPath])
+        }
+    }
+    function play(item) {
+        if (!item || !item.url_resolved) return
+        root.station = item
+        let list = Array.from(Config.options.sidebar.radio.recent).filter(x => x.stationuuid !== item.stationuuid)
+        list.unshift(item)
+        Config.options.sidebar.radio.recent = list.slice(0, 20)
+        root.pendingCommand = ["mpv", "--no-video", "--volume=" + Config.options.sidebar.radio.volume, ...(root.socketPath ? ["--input-ipc-server=" + root.socketPath] : []), item.url_resolved]
+        if (player.running) player.running = false
+        else root.startPending()
+    }
+    function startPending() {
+        if (!root.pendingCommand) return
+        player.command = root.pendingCommand
+        root.pendingCommand = null
+        player.running = true
+    }
+    function stop() { root.pendingCommand = null; player.running = false; root.station = null }
+    Process { id: player; onExited: (code, status) => root.startPending() }
+}
