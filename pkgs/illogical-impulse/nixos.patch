diff -ruN '--exclude=__pycache__' a/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Radio.qml b/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Radio.qml
--- a/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Radio.qml	1970-01-01 00:00:00.000000000 +0000
+++ b/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Radio.qml	2026-11-12 15:57:11.682009474 +0000
@@ -0,0 +1,62 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Quickshell
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+
+Item {
+    id: root
+    property var stations: []
+    property string status: ""
+    property string view: "search"
+    function search() {
+        view = "search"; status = Translation.tr("Loading…")
+        let u = Config.options.sidebar.radio.apiServer + "/json/stations/search?hidebroken=true&order=clickcount&reverse=true&limit=" + Math.max(1, Math.min(100, Config.options.sidebar.radio.limit))
+        if (query.text.trim()) u += "&name=" + encodeURIComponent(query.text.trim())
+        if (Config.options.sidebar.radio.countryCode) u += "&countrycode=" + encodeURIComponent(Config.options.sidebar.radio.countryCode)
+        let xhr = new XMLHttpRequest()
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState !== XMLHttpRequest.DONE) return
+            if (xhr.status !== 200) { root.status = Translation.tr("Request failed"); return }
+            try { root.stations = JSON.parse(xhr.responseText); root.status = root.stations.length ? "" : Translation.tr("No results") }
+            catch(e) { root.status = Translation.tr("Request failed") }
+        }
+        xhr.open("GET", u); xhr.send()
+    }
+    function favorite(item) {
+        let list = Array.from(Config.options.sidebar.radio.favorites)
+        let i = list.findIndex(x => x.stationuuid === item.stationuuid)
+        if (i >= 0) list.splice(i, 1); else list.unshift(item)
+        Config.options.sidebar.radio.favorites = list
+    }
+    ColumnLayout {
+        anchors.fill: parent; anchors.margins: 10; spacing: 8
+        RowLayout {
+            MaterialTextField { id: query; Layout.fillWidth: true; placeholderText: Translation.tr("Search radio stations"); onAccepted: root.search() }
+            Button { text: Translation.tr("Search"); onClicked: root.search() }
+        }
+        RowLayout {
+            Button { text: Translation.tr("Search"); onClicked: root.search() }
+            Button { text: Translation.tr("Favorites"); onClicked: { root.view = "favorites"; root.status = "" } }
+            Button { text: Translation.tr("Recent"); onClicked: { root.view = "recent"; root.status = "" } }
+        }
+        StyledText { Layout.fillWidth: true; text: RadioPlayer.playing ? (Translation.tr("Playing") + ": " + (RadioPlayer.station?.name ?? "")) : root.status; elide: Text.ElideRight }
+        Button { visible: RadioPlayer.playing; text: Translation.tr("Stop"); onClicked: RadioPlayer.stop() }
+        ListView {
+            Layout.fillWidth: true; Layout.fillHeight: true; clip: true; spacing: 4
+            model: root.view === "favorites" ? Config.options.sidebar.radio.favorites : root.view === "recent" ? Config.options.sidebar.radio.recent : root.stations
+            delegate: Rectangle {
+                required property var modelData
+                width: ListView.view.width; height: 52; radius: Appearance.rounding.small; color: Appearance.colors.colLayer2
+                RowLayout {
+                    anchors.fill: parent; anchors.margins: 4
+                    Button { text: "▶"; onClicked: RadioPlayer.play(modelData) }
+                    StyledText { Layout.fillWidth: true; text: modelData.name || ""; elide: Text.ElideRight }
+                    Button { text: Array.from(Config.options.sidebar.radio.favorites).some(x => x.stationuuid === modelData.stationuuid) ? "★" : "☆"; onClicked: root.favorite(modelData) }
+                }
+            }
+        }
+    }
+}
