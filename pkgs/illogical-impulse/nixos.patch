diff -ruN '--exclude=__pycache__' a/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Wallhaven.qml b/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Wallhaven.qml
--- a/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Wallhaven.qml	1970-01-01 00:00:00.000000000 +0000
+++ b/dots/.config/quickshell/ii/modules/ii/sidebarLeft/Wallhaven.qml	2026-11-12 15:57:11.682546362 +0000
@@ -0,0 +1,76 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Io
+import qs.modules.common
+import qs.modules.common.widgets
+
+Item {
+    id: root
+    property var results: []
+    property string status: ""
+    property bool applyAfterDownload: false
+    function search() {
+        status = Translation.tr("Loading…")
+        let c = Config.options.sidebar.wallhaven
+        let u = "https://wallhaven.cc/api/v1/search?q=" + encodeURIComponent(query.text.trim()) + "&categories=" + encodeURIComponent(c.categories) + "&purity=" + encodeURIComponent(c.purity) + "&sorting=" + encodeURIComponent(c.sorting) + "&topRange=" + encodeURIComponent(c.topRange)
+        if (c.atleast) u += "&atleast=" + encodeURIComponent(c.atleast)
+        if (c.ratios) u += "&ratios=" + encodeURIComponent(c.ratios)
+        if (c.apiKey) u += "&apikey=" + encodeURIComponent(c.apiKey)
+        let xhr = new XMLHttpRequest()
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState !== XMLHttpRequest.DONE) return
+            if (xhr.status !== 200) { root.status = Translation.tr("Request failed"); return }
+            try { root.results = JSON.parse(xhr.responseText).data; root.status = root.results.length ? "" : Translation.tr("No results") }
+            catch(e) { root.status = Translation.tr("Request failed") }
+        }
+        xhr.open("GET", u); xhr.send()
+    }
+    function download(item, apply) {
+        if (downloadProc.running) return
+        root.applyAfterDownload = apply
+        root.status = Translation.tr("Downloading…")
+        let directory = Config.options.sidebar.wallhaven.downloadPath || Config.options.wallpaperSelector.directory
+        downloadProc.command = [Quickshell.shellPath("scripts/wallhaven/download.py"), item.path, directory]
+        downloadProc.running = true
+    }
+    Process {
+        id: downloadProc
+        property string result: ""
+        stdout: StdioCollector { onStreamFinished: downloadProc.result = text.trim() }
+        onExited: (code, status) => {
+            if (code !== 0 || !downloadProc.result) { root.status = Translation.tr("Download failed"); return }
+            root.status = Translation.tr("Downloaded") + ": " + downloadProc.result
+            if (root.applyAfterDownload) Quickshell.execDetached([Directories.wallpaperSwitchScriptPath, downloadProc.result])
+            downloadProc.result = ""
+        }
+    }
+    ColumnLayout {
+        anchors.fill: parent; anchors.margins: 10; spacing: 8
+        RowLayout {
+            MaterialTextField { id: query; Layout.fillWidth: true; placeholderText: Translation.tr("Search Wallhaven"); onAccepted: root.search() }
+            Button { text: Translation.tr("Search"); onClicked: root.search() }
+        }
+        StyledText { Layout.fillWidth: true; text: root.status; elide: Text.ElideMiddle }
+        GridView {
+            Layout.fillWidth: true; Layout.fillHeight: true; clip: true
+            cellWidth: Math.max(170, width / 2); cellHeight: 180
+            model: root.results
+            delegate: Item {
+                required property var modelData
+                width: GridView.view.cellWidth; height: GridView.view.cellHeight
+                ColumnLayout {
+                    anchors.fill: parent; anchors.margins: 3; spacing: 3
+                    Image { Layout.fillWidth: true; Layout.fillHeight: true; source: modelData.thumbs?.small ?? ""; fillMode: Image.PreserveAspectCrop; asynchronous: true; cache: true }
+                    StyledText { Layout.fillWidth: true; text: (modelData.resolution ?? "") + " • " + (modelData.id ?? ""); elide: Text.ElideRight }
+                    RowLayout {
+                        Button { text: Translation.tr("Download"); enabled: !downloadProc.running; onClicked: root.download(modelData, false) }
+                        Button { text: Translation.tr("Set"); enabled: !downloadProc.running; onClicked: root.download(modelData, true) }
+                        Button { text: "↗"; onClicked: Qt.openUrlExternally(modelData.url) }
+                    }
+                }
+            }
+        }
+    }
+}
