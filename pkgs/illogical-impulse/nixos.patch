--- upstream/dots/.config/quickshell/ii/services/RadioPlayer.qml	1970-01-01 00:00:00.000000000 +0000
+++ patchsrc/dots/.config/quickshell/ii/services/RadioPlayer.qml	2026-11-12 16:50:04.455251236 +0000
@@ -0,0 +1,53 @@
+pragma Singleton
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.modules.common
+
+Singleton {
+    id: root
+    property var station: null
+    property var queue: []
+    property int queueIndex: -1
+    property bool playing: player.running
+    property var pendingCommand: null
+    readonly property string socketPath: Quickshell.env("XDG_RUNTIME_DIR") ? Quickshell.env("XDG_RUNTIME_DIR") + "/ii-radio-mpv.sock" : ""
+    function setVolume(value) {
+        Config.options.sidebar.radio.volume = Math.max(0, Math.min(100, Math.round(value)))
+        if (player.running && socketPath) volumeTimer.restart()
+    }
+    Timer {
+        id: volumeTimer
+        interval: 70
+        onTriggered: {
+            const payload = JSON.stringify({command: ["set_property", "volume", Config.options.sidebar.radio.volume]})
+            Quickshell.execDetached(["bash", "-c", 'printf "%s\\n" "$1" | socat - "UNIX-CONNECT:$2"', "ii-radio", payload, root.socketPath])
+        }
+    }
+    function play(item, list) {
+        if (!item || !/^https?:\/\//i.test(item.url_resolved || item.url || "")) return
+        if (list && list.length) {
+            root.queue = Array.from(list).filter(x => /^https?:\/\//i.test(x.url_resolved || x.url || ""))
+            root.queueIndex = root.queue.findIndex(x => x.stationuuid === item.stationuuid)
+        }
+        root.station = item
+        const compact = {stationuuid:item.stationuuid, name:item.name, url_resolved:item.url_resolved || item.url, favicon:item.favicon || "", country:item.country || "", countrycode:item.countrycode || ""}
+        let recent = Array.from(Config.options.sidebar.radio.recent).filter(x => x.stationuuid !== item.stationuuid)
+        recent.unshift(compact); Config.options.sidebar.radio.recent = recent.slice(0, 20)
+        root.pendingCommand = ["mpv", "--no-video", "--force-media-title=" + (item.name || "Radio"), "--volume=" + Config.options.sidebar.radio.volume, ...(root.socketPath ? ["--input-ipc-server=" + root.socketPath] : []), item.url_resolved || item.url]
+        if (player.running) player.running = false
+        else root.startPending()
+    }
+    function startPending() {
+        if (!root.pendingCommand) return
+        player.command = root.pendingCommand; root.pendingCommand = null; player.running = true
+    }
+    function stop() { root.pendingCommand = null; player.running = false }
+    function resume() { if (root.station) root.play(root.station) }
+    function skip(direction) {
+        if (!root.queue.length) return
+        root.queueIndex = (root.queueIndex + direction + root.queue.length) % root.queue.length
+        root.play(root.queue[root.queueIndex])
+    }
+    Process { id: player; onExited: (code, status) => root.startPending() }
+}
