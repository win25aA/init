--- a/dots/.config/quickshell/ii/scripts/wallhaven/download.py	1970-01-01 00:00:00.000000000 +0000
+++ b/dots/.config/quickshell/ii/scripts/wallhaven/download.py	2026-11-12 15:57:11.682700593 +0000
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+# Сохраняем изображения только с CDN Wallhaven, временный файл переименовывается после загрузки.
+import os, pathlib, re, sys, tempfile
+from urllib.parse import urlparse
+import requests
+url, folder = sys.argv[1:3]
+u = urlparse(url)
+if u.scheme != "https" or u.hostname != "w.wallhaven.cc" or not re.fullmatch(r"/[a-z0-9]{2}/wallhaven-[a-z0-9]+\.(jpg|png)", u.path):
+    raise SystemExit("Invalid Wallhaven image URL")
+dest = pathlib.Path(folder).expanduser()
+dest.mkdir(parents=True, exist_ok=True)
+fd, temp = tempfile.mkstemp(prefix=".wallhaven-", dir=dest)
+try:
+    with os.fdopen(fd, "wb") as f, requests.get(url, timeout=(10, 120), stream=True, allow_redirects=False) as r:
+        r.raise_for_status()
+        for chunk in r.iter_content(65536): f.write(chunk)
+    path = dest / pathlib.PurePosixPath(u.path).name
+    os.replace(temp, path)
+    print(path)
+finally:
+    if os.path.exists(temp): os.unlink(temp)
